# Copy to .env and fill in. .env is gitignored; this file is not.

# Where the CLI looks for the Hono server.
API_URL="http://localhost:3000"

# Postgres connection string. Neon gives you this on the project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Provider key for whichever model DEFAULT_CHAT_MODEL_ID names. Each provider
# reads its own variable, under exactly these names.

# Free tier, no card. Get one at aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# Paid only. Get one at console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-api03-..."
