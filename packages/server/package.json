{
  "name": "@novacode/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.111",
    "@ai-sdk/google": "^3.0.110",
    "@ai-sdk/provider-utils": "4.0.46",
    "@clerk/backend": "^3.16.9",
    "@hono/zod-validator": "^0.9.0",
    "@novacode/database": "workspace:*",
    "@novacode/shared": "workspace:*",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/bun": "^10.70.0",
    "@sentry/hono": "^10.70.0",
    "ai": "^6.0.258",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  }
}
