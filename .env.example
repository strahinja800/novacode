# Copy to .env and fill in. .env is gitignored; this file is not.

# Where the CLI looks for the Hono server.
API_URL="http://localhost:3000"

# Postgres connection string. Neon gives you this on the project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Public origin the browser is redirected back to after checkout. Only needed
# behind a proxy, where the request URL is the internal address.
# PUBLIC_APP_ORIGIN="https://novacode.example.com"

# --- Model providers ---------------------------------------------------------
# Each provider reads its own variable, under exactly these names. You only
# need the one that DEFAULT_CHAT_MODEL_ID points at.

# Free tier, no card. Get one at aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."

# Paid only. Get one at console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-api03-..."

# --- Clerk -------------------------------------------------------------------
# From the Clerk dashboard. The OAuth application must be public, with scopes
# openid profile email offline_access, and http://localhost:3000/oauth/callback
# registered as a redirect URL.

CLERK_FRONTEND_API="https://your-instance.clerk.accounts.dev"
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_OAUTH_CLIENT_ID="..."

# --- Polar -------------------------------------------------------------------
# Create the meter, benefit and product in the sandbox first. The meter must
# filter on the event name `novacode_usage` and sum the property `credits`.

POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN="polar_oat_..."
POLAR_PRODUCT_ID="..."
POLAR_CREDITS_METER_ID="..."
